# Entity: inbox

main: kit: entity: inbox: {

  alias: field: {}

  fields: [
    {
      name: "address"
      req: false
      short: "The generated temporary email address"
      type: "`$STRING`"
    }
    {
      name: "token"
      req: false
      short: "Authentication token for accessing this inbox"
      type: "`$STRING`"
    }
  ]

  name: "inbox"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "domain"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "username"
                orig: "username"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/custom/{username}@{domain}"
          parts: [
            "custom"
            "{username}@{domain}"
          ]
          select: {
            exist: [
              "domain"
              "username"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/generate"
          parts: [
            "generate"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "custom"
      ]
    ]
  }



}
