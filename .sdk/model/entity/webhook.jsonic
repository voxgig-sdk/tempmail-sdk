# Entity: webhook

main: kit: entity: webhook: {

  alias: field: {}

  fields: [
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "token"
      req: true
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "webhook_id"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "webhook"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/webhook"
          parts: [
            "webhook"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "webhook_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/webhook/{webhookId}"
          parts: [
            "webhook"
            "{id}"
          ]
          rename: {
            param: {
              webhookId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
