# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: [
    {
      name: "attachment"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "body"
      req: false
      type: "`$STRING`"
    }
    {
      name: "date"
      req: false
      type: "`$STRING`"
    }
    {
      name: "from"
      req: false
      type: "`$STRING`"
    }
    {
      name: "html"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "subject"
      req: false
      type: "`$STRING`"
    }
    {
      name: "to"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "email"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "message_id"
                orig: "message_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "token"
                orig: "token"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/inbox/{token}/message/{messageId}"
          parts: [
            "inbox"
            "{token}"
            "message"
            "{message_id}"
          ]
          rename: {
            param: {
              messageId: "message_id"
            }
          }
          select: {
            exist: [
              "message_id"
              "token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "inbox"
        "message"
      ]
    ]
  }



}
